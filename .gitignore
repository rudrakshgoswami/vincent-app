# Dependencies
node_modules/
*/node_modules/

# Build output
client/dist/
dist/

# Secrets. Never commit these. See server/.env.example for the shape.
.env
.env.local
.env.*.local
*/.env
server/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

