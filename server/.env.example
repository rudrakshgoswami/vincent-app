PORT=5000
MONGO_URI=mongodb://localhost:27017/vincent_db

# Auth. Use long random strings, different from each other.
JWT_SECRET=your_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key

# Seed admin, read by scripts/create-admin.js.
# There is no default: the script refuses to run without these.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password

# Email (Gmail app password, not your account password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Vincent Restaurant <noreply@example.com>

# SMS (Twilio). Optional: OTP falls back to Fast2SMS.
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Alternate SMS (Fast2SMS)
FAST2SMS_API_KEY=your_fast2sms_key

# Payments (Razorpay). Use test-mode keys for development.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
